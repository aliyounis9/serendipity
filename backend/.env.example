# Copy this file to .env and replace the placeholder password.

# Used by Docker Compose to create the local database
POSTGRES_USER=serendipity
POSTGRES_PASSWORD=change-me
POSTGRES_DB=serendipity

# Used by the FastAPI app to connect (same credentials as above)
DATABASE_URL=postgresql+psycopg://serendipity:change-me@localhost:5432/serendipity
